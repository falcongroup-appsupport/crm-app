# Base URL of the Spring Boot backend described in CRM_APIS.pdf.
VITE_API_BASE_URL=http://192.168.0.212:8081

# Optional upload limits checked in the browser before submitting (0 = off; the server decides).
# Set them to the backend's spring.servlet.multipart limits (Spring Boot defaults: 1 MB per file,
# 10 MB per request) so oversized files are flagged in the form instead of returning HTTP 413.
VITE_MAX_UPLOAD_MB=0
VITE_MAX_REQUEST_MB=0
